import { Theme } from "theme.slint";
import {
    KitButton, KitIconButton, KitCheckBox, KitLineEdit, KitComboBox, KitAlignPad,
    KitDisplay, KitMuted, KitTitle, KitLabel, KitWarning, KitBadge,
    KitVStack, KitHStack, KitSpacer, KitDivider,
    KitField, KitListRow, KitDisclosure, KitToolbar, KitHeadingStack,
    KitConfirm, Panel
} from "widgets.slint";
import { Palette, ScrollView } from "std-widgets.slint";

export { Theme, Palette }

export component Gallery inherits Window {
    title: "slint-kit gallery";
    preferred-width: 560px;
    preferred-height: 820px;
    background: Theme.page-bg;

    in-out property <string> status: "Ready";
    in-out property <string> edit-text: "edit me";
    in-out property <[string]> combo-model: ["One", "Two", "Three"];
    in-out property <int> combo-index: 0;
    in-out property <bool> check-on: true;
    in-out property <bool> advanced: false;
    in-out property <string> secret: "";
    in-out property <bool> confirming: false;
    in-out property <bool> remove-home: false;

    public function sync-palette() {
        Palette.color-scheme = Theme.mode == "light" ? ColorScheme.light : ColorScheme.dark;
    }

    ScrollView {
        width: 100%;
        height: 100%;
        KitVStack {
            gap: "loose";
            padding: Theme.space-xl;

            KitDisplay { text: "slint-kit · " + Theme.mode; }
            KitMuted {
                text: "Density + chrome helpers. LMTT live-reloads colors.";
                wrap-text: true;
            }

            KitTitle { text: "Colors"; }
            KitHStack {
                gap: "form";
                Rectangle { width: 48px; height: 48px; border-radius: Theme.radius-md; background: Theme.accent; }
                Rectangle {
                    width: 48px; height: 48px; border-radius: Theme.radius-md;
                    background: Theme.panel-bg; border-width: Theme.border-width; border-color: Theme.border;
                }
                Rectangle { width: 48px; height: 48px; border-radius: Theme.radius-md; background: Theme.danger; }
                Rectangle { width: 48px; height: 48px; border-radius: Theme.radius-md; background: Theme.tile-selected; }
            }

            KitTitle { text: "Metrics"; }
            KitLabel {
                text: "row " + Theme.row-height / 1px
                    + " · control " + Theme.control-height / 1px
                    + " · fonts " + Theme.font-label / 1px + "/" + Theme.font-body / 1px
                    + "/" + Theme.font-title / 1px + "/" + Theme.font-display / 1px;
            }

            KitDivider { }
            KitTitle { text: "Controls"; }
            KitHStack {
                gap: "form";
                center: true;
                KitButton { text: "Primary"; primary: true; clicked => { root.status = "Primary"; } }
                KitButton { text: "Default"; clicked => { root.status = "Default"; } }
                KitButton { text: "Danger"; danger: true; clicked => { root.status = "Danger"; } }
                KitButton { text: "Small"; small: true; clicked => { root.status = "Small"; } }
                KitIconButton { text: "+"; small: true; clicked => { root.status = "Icon+"; } }
                KitSpacer { }
                KitBadge { text: "shared"; tone: "accent"; }
            }

            KitField {
                label: "Line edit";
                hint: "optional hint";
                KitLineEdit {
                    text: root.edit-text;
                    edited(t) => { root.edit-text = t; root.status = "Edited: " + t; }
                }
            }
            KitField {
                label: "Password";
                hint: "placeholder + Enter → accepted";
                KitLineEdit {
                    text <=> root.secret;
                    input-type: password;
                    placeholder: "New password";
                    accepted(t) => { root.status = "Accepted " + t.character-count + " chars"; }
                }
            }
            KitField {
                label: "Combo";
                KitComboBox {
                    model: root.combo-model;
                    current-index: root.combo-index;
                    selected(i) => { root.combo-index = i; root.status = "Combo: " + root.combo-model[i]; }
                }
            }

            KitCheckBox {
                text: "Snap / toggle sample";
                checked: root.check-on;
                toggled(v) => { root.check-on = v; root.status = v ? "Checked" : "Unchecked"; }
            }

            KitDisclosure {
                label: "Match / advanced";
                open <=> root.advanced;
            }
            if root.advanced: KitLabel { text: "advanced body"; }

            KitTitle { text: "List"; }
            KitListRow {
                title: "ultrawide-with-secondary";
                meta: "user";
                matched: true;
                active: true;
                clicked => { root.status = "Row clicked"; }
            }
            KitListRow {
                title: "office";
                meta: "shared";
                clicked => { root.status = "Row 2"; }
            }
            KitListRow {
                title: "Ada Lovelace";
                meta: "Administrator";
                initials: "AL";
                clicked => { root.confirming = true; }
            }
            if root.confirming: KitConfirm {
                title: "Delete ada?";
                message: "Their files stay unless you remove the home directory.";
                KitCheckBox {
                    text: "Remove home directory";
                    checked: root.remove-home;
                    toggled(v) => { root.remove-home = v; }
                }
                confirmed => { root.confirming = false; root.status = root.remove-home ? "Deleted + home" : "Deleted"; }
                cancelled => { root.confirming = false; root.status = "Cancelled"; }
            }

            Panel {
                KitVStack {
                    gap: "form";
                    padding: Theme.space-md;
                    KitAlignPad {
                        place(op) => {
                            if (op == 0) { root.status = "Place Left"; }
                            if (op == 1) { root.status = "Place Right"; }
                            if (op == 2) { root.status = "Place Above"; }
                            if (op == 3) { root.status = "Place Below"; }
                        }
                    }
                }
            }

            KitWarning { text: "Sample warning callout"; }
            KitMuted { text: root.status; }
        }
    }
}
